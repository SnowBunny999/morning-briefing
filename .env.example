# 复制为 .env 后填入你自己的密钥（本地调试用，不要提交到 git）
# LLM 默认用 DeepSeek（便宜、中文好），也可换成通义千问等兼容 OpenAI 的接口

# 必填：LLM API Key
LLM_API_KEY=你的_llm_api_key

# 选填：兼容 OpenAI 的接口地址
#   DeepSeek（默认）：https://api.deepseek.com/v1
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 选填：模型名
#   DeepSeek：deepseek-chat
#   通义千问：qwen-plus 或 qwen-turbo
LLM_MODEL=deepseek-chat

# 必填：Server酱 SENDKEY（微信推送），在 https://sct.ftqq.com 申请
SERVERCHAN_KEY=你的_serverchan_sendkey
